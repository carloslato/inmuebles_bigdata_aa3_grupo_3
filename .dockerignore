# Git
.git/
.gitattributes
.gitignore

# Dependencies
**/node_modules/
**/__pycache__/
**/*.pyc
**/.venv/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
Thumbs.db
.DS_Store

